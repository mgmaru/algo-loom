{
  "manifest_version": 3,
  "name": "AlgoLoom V-10 Verification Helper",
  "version": "0.1.0",
  "description": "One-run helper for a human-operated AtCoder method-A verification.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://atcoder.jp/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://atcoder.jp/settings*"
      ],
      "js": [
        "atcoder.js"
      ],
      "run_at": "document_end"
    }
  ]
}
